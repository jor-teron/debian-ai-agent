# Default provider: gemini | openai | xai | anthropic | deepseek | openrouter | deepinfra
# Local (no API key): ollama | llamacpp — see OLLAMA_BASE_URL / LLAMACPP_BASE_URL below
PROVIDER=gemini

# API keys (set the ones you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=

# Optional default model per provider (must be in that provider's allowlist)
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_MODEL=gpt-4o-mini
# XAI_MODEL=grok-4.3
# ANTHROPIC_MODEL=claude-haiku-4-5
# DEEPSEEK_MODEL=deepseek-chat
# OPENROUTER_MODEL=openrouter/auto
# DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Listen address. 127.0.0.1 = this PC only. 0.0.0.0 = LAN (other devices).
HOST=127.0.0.1
PORT=9191

# Agent jail (whole tree). Default = ~/ai-workspace
# Subdirs created on start/install: memory/ workspace/ test/ trash/ user/
# Prefer workspace/ for new agent work. user/ is agent read-only (list/read OK).
# WORKSPACE=/home/myname/ai-workspace

# Session memory (memory/session.md) auto-clear:
# If neither is set, session older than 24h is cleared.
# If both are set, either condition clears it.
# SESSION_RESET_HOURS=24
# SESSION_RESET_AFTER=01:00

# Optional Telegram DM bridge (long polling — no public URL / webhook).
# 1) Message @BotFather → /newbot → paste token below
# 2) DM your bot once; if ALLOWED is empty the bot replies with your chat id
# 3) Set TELEGRAM_ALLOWED_CHAT_ID and restart
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# Optional overrides (else PROVIDER / default model):
# TELEGRAM_PROVIDER=gemini
# TELEGRAM_MODEL=gemini-3.5-flash-lite

# Optional: install bubblewrap (apt install bubblewrap) for sandboxed shell freehand.
# Without bwrap, shell commands still need UI Confirm / Telegram YES-NO.

# --- Shell / sudo ---
# ALLOW_SUDO=1 (default): agent may queue sudo (always Confirm / Telegram YES [password]).
# ALLOW_SUDO=0: refuse sudo entirely.
ALLOW_SUDO=1
# Shell network: default ON (even inside bubblewrap). SHELL_NET=0 adds --unshare-net.
SHELL_NET=1
# SHELL_NET=0

# --- Status LED (UI) ---
# Red LED blink period in ms when not ready (missing key / local runtime).
# Green is solid (no blink). No UI control — .env only.
STATUS_BLINK_MS=2000

# --- Local runtimes (optional; not installed by install.sh) ---
# Ollama OpenAI-compat: http://127.0.0.1:11434/v1/chat/completions
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional: OLLAMA_MODEL=llama3.2:3b
# llama.cpp server (llama-server) OpenAI-compat on :8080
LLAMACPP_BASE_URL=http://127.0.0.1:8080
# Optional: LLAMACPP_MODEL=llama-3.2-3b

# --- Soft light theme (optional UI color overrides) ---
# Empty = built-in soft gray defaults (no pure white). Hex only: #rgb or #rrggbb.
# Applied by the browser while light theme is active (dark theme unchanged).
UI_LIGHT_BG=
UI_LIGHT_PANEL=
UI_LIGHT_BORDER=
UI_LIGHT_TEXT=
UI_LIGHT_MUTED=
UI_LIGHT_USER=
UI_LIGHT_BOT=
UI_LIGHT_BOT_BORDER=
UI_LIGHT_INPUT=
