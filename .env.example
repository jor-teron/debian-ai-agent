# Default provider: gemini | openai | xai | anthropic | deepseek | openrouter | deepinfra
PROVIDER=gemini

# API keys (set the ones you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=

# Optional default model per provider (must be in that provider's allowlist)
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_MODEL=gpt-4o-mini
# XAI_MODEL=grok-4.3
# ANTHROPIC_MODEL=claude-haiku-4-5
# DEEPSEEK_MODEL=deepseek-chat
# OPENROUTER_MODEL=openrouter/auto
# DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Optional. Default = /home/$USER/ai-workspace
# WORKSPACE=/home/myname/ai-workspace
# Local browser only (localhost). Port default 9191.
# Listen address. 127.0.0.1 = this PC only. 0.0.0.0 = LAN (other devices).
HOST=127.0.0.1
PORT=9191

# Session memory (memory/session.md) auto-clear:
# If neither is set, session older than 24h is cleared.
# If both are set, either condition clears it.
# SESSION_RESET_HOURS=24
# SESSION_RESET_AFTER=01:00

# Optional Telegram DM bridge (long polling — no public URL / webhook).
# 1) Message @BotFather → /newbot → paste token below
# 2) DM your bot once; if ALLOWED is empty the bot replies with your chat id
# 3) Set TELEGRAM_ALLOWED_CHAT_ID and restart
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# Optional overrides (else PROVIDER / default model):
# TELEGRAM_PROVIDER=gemini
# TELEGRAM_MODEL=gemini-3.5-flash-lite

# Optional: install bubblewrap (apt install bubblewrap) for sandboxed shell freehand.
# Without bwrap, shell commands still need UI Confirm / Telegram YES-NO.
