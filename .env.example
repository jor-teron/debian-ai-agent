# Default provider: gemini | openai | xai | anthropic | deepseek
PROVIDER=gemini

# API keys (set the ones you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Optional default model per provider (must be in that provider's allowlist)
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_MODEL=gpt-4o-mini
# XAI_MODEL=grok-4.3
# ANTHROPIC_MODEL=claude-haiku-4-5
# DEEPSEEK_MODEL=deepseek-chat

# Optional. Default = /home/$USER/ai-agent
# WORKSPACE=/home/myname/ai-agent
# Listen address (default localhost only). Use 0.0.0.0 for phone on same WiFi.
HOST=127.0.0.1
PORT=8787
