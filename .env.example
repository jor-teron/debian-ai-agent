# Get a key: https://aistudio.google.com/apikey  (same key works for Free + Paid if project has access)
GEMINI_API_KEY=

# Default model when the UI does not override (should be a Free Flash id)
GEMINI_MODEL=gemini-3.5-flash-lite

# Bind localhost only — never expose to the LAN by default
HOST=127.0.0.1
PORT=8787

# Tool jail root (agent may only touch files under here unless AGENT_ALLOW_SYSTEM=1)
WORKSPACE=/home/user/agent-workspace

# Optional safety overrides (leave unset for safe defaults)
# AGENT_ALLOW_SYSTEM=1
# AGENT_ALLOW_SUDO=1
